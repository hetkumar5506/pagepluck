{
  "name": "pagepluck",
  "displayName": "PagePluck — Web Asset & Design Token Exporter",
  "version": "0.2.0",
  "description": "Fast, local-only Chrome extension to inspect, pluck, and export images, inline SVGs, CSS backgrounds, color palettes, and fonts from any website.",
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "wxt",
    "asset-downloader",
    "svg-extractor",
    "image-downloader",
    "palette-extractor",
    "color-picker",
    "font-inspector",
    "design-tokens",
    "web-scraper",
    "developer-tools",
    "react19",
    "tailwind-css"
  ],
  "author": "Het Patel <hetkumar5506@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/hetkumar5506/pagepluck#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hetkumar5506/pagepluck.git"
  },
  "bugs": {
    "url": "https://github.com/hetkumar5506/pagepluck/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "prepare": "wxt prepare",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm run build && node tests/e2e.mjs",
    "check": "npm run typecheck && npm run test:e2e && npm audit --omit=dev",
    "clean": "rm -rf .output .wxt playwright-report test-results"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@wxt-dev/module-react": "^1.2.2",
    "motion": "^13.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reicon-react": "^1.2.5",
    "tailwindcss": "^4.3.3",
    "wxt": "^0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
